# Copia este archivo a .env y completa lo que necesites. NUNCA subas .env a git.

# Redis: estado de los trabajos, cola y checkpoints de LangGraph
REDIS_URL=redis://localhost:6379/0

# Worker: tareas en paralelo y si corre dentro de la API (false = proceso aparte con python -m app.worker)
WORKER_CONCURRENCY=5
RUN_WORKER_IN_API=true

# LLM: "anthropic", "openai" u "ollama". Solo necesitas la clave del proveedor que uses.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SUPERVISOR_MODEL=claude-sonnet-5-5
# WORKER_MODEL=claude-haiku-5-5
# OLLAMA_BASE_URL=http://localhost:11434

# Observabilidad con LangSmith (clave gratuita en smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=api-agentes-produccion
